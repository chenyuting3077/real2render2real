+    def _set_value_no_cb(element, value):
+        """Set a viewer element's value without firing its callback.
+
+        viser calls on_update callbacks synchronously when .value is assigned, and nerfstudio
+        wraps every element callback in the (non-reentrant) viewer train_lock. Assigning a value
