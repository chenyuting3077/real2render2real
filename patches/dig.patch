+        deadlocks the whole viewer. Temporarily swap out cb_hook (it is looked up late).
+        """
+        hook = element.cb_hook
+        element.cb_hook = lambda _: None
+        try:
+            element.value = value
+        finally:
+            element.cb_hook = hook
